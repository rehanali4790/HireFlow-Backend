# Database Configuration
DB_HOST=localhost
DB_PORT=5432
DB_NAME=hireflow_db
DB_USER=postgres
DB_PASSWORD=your_password

# Server Configuration
PORT=3001
NODE_ENV=development

# JWT Secret
JWT_SECRET=your-super-secret-jwt-key-change-this

# Email Configuration (SMTP)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASSWORD=your_app_password
SMTP_FROM_NAME=HireFlow
SMTP_FROM_EMAIL=your_email@gmail.com

# OpenAI API Key (for AI features)
OPENAI_API_KEY=sk-your-openai-api-key

# Application URL
APP_URL=http://localhost:5173

# External Jobs API (Basic Auth — single endpoint for company career website)
# GET /api/external/jobs — all jobs + filter_options (no params)
# GET /api/external/jobs?q=IT&location=Karachi&department=Software — filtered
# GET /api/external/jobs?page=1&limit=10 — paginated (optional)
EXTERNAL_API_USERNAME=hireflow_api
EXTERNAL_API_PASSWORD=change-this-external-api-password
EXTERNAL_API_EMPLOYER_ID=your-employer-uuid-here

# Super Admin (ENV only — not stored in DB, no activity logs)
SUPER_ADMIN_EMAIL=superadmin@hireflow.com
SUPER_ADMIN_PASSWORD=change-this-password
